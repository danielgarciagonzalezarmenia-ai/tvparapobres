# Servidor Xtream (sin / al final)
XTREAM_SERVER=http://tu-servidor:8880
XTREAM_USERNAME=tu_usuario
XTREAM_PASSWORD=tu_password
PORT=4000

# ROTACIÓN DE USUARIOS (opcional pero recomendada)
# Si configuras XTREAM_USERS, el sitio distribuirá las peticiones entre todos
# los usuarios en orden rotativo (round-robin), reduciendo el riesgo de que el
# proveedor bloquee una cuenta por demasiadas solicitudes.
# Formato JSON:
# XTREAM_USERS=[{"user":"usuario1","pass":"pass1"},{"user":"usuario2","pass":"pass2"}]
# Si se deja vacío ([]) o se omite, se usa solo XTREAM_USERNAME/XTREAM_PASSWORD.