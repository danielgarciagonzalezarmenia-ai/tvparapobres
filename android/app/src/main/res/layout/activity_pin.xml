<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="222dp"
            android:layout_height="64dp"
            android:adjustViewBounds="true"
            android:contentDescription="TV Para Pobres"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_proyecto" />

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_form_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <com.tvparapobres.app.AvatarView
                android:id="@+id/pinAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp" />

            <TextView
                android:id="@+id/pinName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/outfit"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_form_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/pinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Ingresa tu PIN"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/dotsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot0"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginHorizontal="6dp" />

                <View
                    android:id="@+id/dot1"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginHorizontal="6dp" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginHorizontal="6dp" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginHorizontal="6dp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="3"
                android:rowCount="4"
                android:useDefaultMargins="true" />

            <TextView
                android:id="@+id/btnPinBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_ghostbtn"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/outfit"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="Volver"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
