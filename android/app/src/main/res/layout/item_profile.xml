<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileCard"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/bg_card_focus"
    app:cardBackgroundColor="@color/panel"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/white10"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <com.tvparapobres.app.AvatarView
                android:id="@+id/profileAvatar"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pinbadge"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.1"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="PIN"
                android:textAllCaps="true"
                android:textColor="@color/accentStrong"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/profileDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pickedit"
            android:fontFamily="sans-serif"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/textMuted"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/profileEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:alpha="0.6"
            android:background="@drawable/bg_pickedit"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="6dp"
            android:src="@drawable/ic_pencil"
            android:tint="@color/textMuted" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
