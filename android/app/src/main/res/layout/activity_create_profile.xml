<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_donate"
                android:fontFamily="sans-serif-black"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="‹ VOLVER"
                android:textColor="#ffffff"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="NUEVO PERFIL"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="26dp"
            android:paddingTop="26dp">

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:fontFamily="sans-serif-medium"
                android:hint="Nombre del perfil"
                android:inputType="textCapWords"
                android:maxLength="18"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textMuted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_donate"
                android:fontFamily="sans-serif-black"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="CREAR"
                android:textColor="#ffffff"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="26dp"
            android:paddingTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:text="COLOR"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/paletteRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="26dp"
            android:paddingTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:text="PIN OPCIONAL (déjalo vacío para no proteger)"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:fontFamily="sans-serif-monospace"
            android:hint="0000"
            android:inputType="number"
            android:maxLength="4"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textMuted"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>