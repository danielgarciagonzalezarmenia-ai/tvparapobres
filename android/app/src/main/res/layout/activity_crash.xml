<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060608"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="La app se cerró inesperadamente"
            android:textColor="#f2f3f5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/crashVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#a3a6ad"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/crashTrace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#121316"
            android:padding="12dp"
            android:textColor="#f2f3f5"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#24ff4d2e"
            android:gravity="center"
            android:padding="12dp"
            android:text="COPIAR ERROR"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#141518"
            android:gravity="center"
            android:padding="12dp"
            android:text="REINTENTAR"
            android:textColor="#a3a6ad"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="Cerrar"
            android:textColor="#6e747c"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
