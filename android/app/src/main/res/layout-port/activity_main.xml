<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/btnProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_prochip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="2dp">

            <com.tvparapobres.app.AvatarView
                android:id="@+id/proAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_headbtn"
            android:fontFamily="@font/outfit"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="11dp"
            android:paddingVertical="7dp"
            android:text="★"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnHist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_headbtn"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="6dp"
            android:drawableTint="@color/textPrimary"
            android:fontFamily="@font/outfit"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="11dp"
            android:paddingVertical="7dp"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDonate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_donate"
            android:fontFamily="@font/outfit"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="♥ Apoyar"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:fontFamily="@font/outfit"
        android:hint="Buscar..."
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textMuted"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tab_bar"
        android:padding="4dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabBackground="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabMinWidth="0dp"
            app:tabPaddingStart="2dp"
            app:tabPaddingEnd="2dp"
            app:tabRippleColor="@color/accentFocus" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/catScroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/catRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/gridDash"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_grid_dash" />

        <TextView
            android:id="@+id/gridTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.1"
            android:text="CANALES"
            android:textAllCaps="true"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gridCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_count"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingHorizontal="9dp"
            android:paddingVertical="2dp"
            android:text="0"
            android:textColor="@color/accentStrong"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:descendantFocusability="afterDescendants"
        android:focusable="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/skelGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:padding="60dp"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/servLock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_servbrand">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_brand_tv" />
        </FrameLayout>

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/servTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="Sin servicio por el momento"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/servSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:textColor="@color/textSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/servHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:textColor="#59ffffff"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
